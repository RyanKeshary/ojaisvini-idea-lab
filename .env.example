# Demo switches. Everything third-party is mocked by default.
NEXT_PUBLIC_DEMO=1
OJAS_DEMO=1

# Database (dev: SQLite file; prod: Postgres URL)
DATABASE_URL="file:./dev.db"

# Auth.js session secret (generate a fresh one per environment)
AUTH_SECRET="dev-secret-change-in-production-please-1234567890"

# --- AI provider (Groq; server-side only) ---
# AI_PROVIDER=mock (default: deterministic fixtures, no key, no network)
# AI_PROVIDER=groq requires GROQ_API_KEY in .env.local (NEVER commit the key).
AI_PROVIDER=mock
GROQ_API_KEY=
# Model IDs change often — verify at console.groq.com/docs/models.
GROQ_MODEL_CHAT=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_VISION=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MODEL_STT=whisper-large-v3-turbo
# Per-user AI call budget (calls/minute; enforced on AI routes)
AI_CALLS_PER_MIN=20

# Public site URL (metadata/OG absolute URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
